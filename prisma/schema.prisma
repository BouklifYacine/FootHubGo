generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Models and fields are named in English. `@map` / `@@map` keep the original
// (French) database table, column and enum names, so no data migration is needed.

model User {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  email                    String                    @unique
  emailVerified            Boolean
  image                    String?
  role                     UserRole                  @default(USER)
  /// Legacy per-user plan / Stripe customer: billing now belongs to the club (Club.plan).
  plan                     Plan                      @default(free)
  clientId                 String?                   @unique
  resetToken               String?
  resetTokenExpiry         DateTime?
  createdAt                DateTime
  updatedAt                DateTime
  isOnline                 Boolean                   @default(false)
  lastSeen                 DateTime?
  /// Event reminder emails (the day before). Turned off from the settings or the unsubscribe link.
  emailReminders           Boolean                   @default(true)
  /// Onboarding steps already seen / dismissed, per user so they follow them across devices:
  /// tours ("coach-v1", "player-v1") and the coach checklist ("coach-checklist").
  onboardingSeen           String[]                  @default([])
  callUps                  CallUp[]
  memberships              TeamMember[]
  clubMembership           ClubMember?
  /// Legacy: subscriptions bought before clubs existed, by users who own no club (see ARCHITECTURE.md).
  subscription             Subscription?
  accounts                 Account[]
  injuries                 Injury[]
  conversationParticipants ConversationParticipant[]
  joinRequests             JoinRequest[]
  finances                 Finance[]
  sentMessages             Message[]
  notifications            Notification[]
  attendances              Attendance[]
  pollResponses            PollResponse[]
  sessions                 Session[]
  createdPolls             Poll[]
  playerStats              PlayerStat[]
  favoriteTeams            Team[]                    @relation("ClubsFavoris")
  favoritePlayers          User[]                    @relation("JoueursFavoris")
  favoritedBy              User[]                    @relation("JoueursFavoris")
  messageDeletions         MessageDeletion[]
  blockedUsers             User[]                    @relation("UserBlocks")
  blockedBy                User[]                    @relation("UserBlocks")
  createdGroups            Conversation[]            @relation("GroupCreator")
  conversations            Conversation[]
  motmVotesCast            MotmVote[]                @relation("MotmVoter")
  motmVotesReceived        MotmVote[]                @relation("MotmNominee")
  ridesOffered             Ride[]
  rideSeats                RidePassenger[]

  @@map("user")
}

/// A club: owns its sections, members (club roles), the club chat channel and the subscription.
model Club {
  id               String         @id @default(cuid())
  name             String
  description      String?
  logoUrl          String?
  visibility       ClubVisibility @default(PUBLIC)
  createdAt        DateTime       @default(now())
  /// Billing belongs to the club (paid by the OWNER).
  plan             Plan           @default(free)
  stripeCustomerId String?        @unique
  sections         Team[]
  members          ClubMember[]
  events           Event[]
  conversation     Conversation?
  subscription     Subscription?

  @@map("club")
}

/// Club role of a user (one club per user for now: `userId` is unique).
model ClubMember {
  id                 String       @id @default(cuid())
  role               ClubRole     @default(MEMBER)
  joinedAt           DateTime     @default(now())
  clubId             String
  userId             String       @unique
  club               Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionMemberships TeamMember[]

  @@unique([clubId, userId])
  /// Exactly one OWNER per club.
  @@unique([clubId], map: "club_member_one_owner_key", where: { role: "OWNER" })
  @@map("club_member")
}

/// A SECTION of a club (e.g. "Seniors A"). The model keeps its historical name (`Team`, table `equipe`).
model Team {
  id           String          @id @default(cuid())
  name         String          @map("nom")
  createdAt    DateTime        @default(now()) @map("dateCreation")
  inviteCode   String?         @unique @map("codeInvitation")
  level        TeamLevel       @default(RECREATIONAL) @map("niveau")
  category     SectionCategory @default(SENIOR)
  clubId       String
  club         Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  injuries     Injury[]
  joinRequests JoinRequest[]
  events       Event[]
  finances     Finance[]
  polls        Poll[]
  teamStats    TeamStat[]
  favoritedBy  User[]          @relation("ClubsFavoris")
  conversation Conversation?

  @@unique([clubId, name])
  @@index([clubId])
  @@map("equipe")
}

model TeamMember {
  id         String          @id @default(cuid())
  role       TeamRole        @default(PLAYER)
  position   PlayerPosition? @map("poste")
  isLicensed Boolean         @default(false)
  joinedAt   DateTime        @default(now())
  userId     String
  teamId     String          @map("equipeId")
  /// Same club as the section: a section member is always a club member (composite FK).
  clubId     String
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubMember ClubMember      @relation(fields: [clubId, userId], references: [clubId, userId], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([clubId, userId])
  @@map("MembreEquipe")
}

model JoinRequest {
  id         String            @id @default(cuid())
  position   PlayerPosition    @map("poste")
  motivation String
  status     JoinRequestStatus @default(PENDING) @map("statut")
  createdAt  DateTime          @default(now())
  userId     String
  teamId     String            @map("equipeId")
  level      TeamLevel         @map("niveau")
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("demande_adhesion")
}

model Injury {
  id          String   @id @default(cuid())
  type        String
  description String?
  startDate   DateTime
  endDate     DateTime
  isRecurring Boolean  @default(false)
  userId      String
  teamId      String   @map("equipeId")
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@map("blessure")
}

model Finance {
  id          String      @id @default(cuid())
  amount      Float       @map("montant")
  type        FinanceType
  description String
  isPaid      Boolean     @default(false)
  dueDate     DateTime?   @map("dateEcheance")
  userId      String
  teamId      String      @map("equipeId")
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("finance")
}

model CallUp {
  id          String       @id @default(cuid())
  userId      String
  eventId     String       @map("evenementId")
  status      CallUpStatus @default(PENDING) @map("statut")
  sentAt      DateTime     @default(now()) @map("dateEnvoi")
  respondedAt DateTime?    @map("dateReponse")
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, status])
  @@map("Convocation")
}

model Event {
  id                 String          @id @default(cuid())
  title              String          @map("titre")
  description        String?
  location           String?         @map("lieu")
  type               EventType       @default(TRAINING) @map("typeEvenement")
  startDate          DateTime        @map("dateDebut")
  createdAt          DateTime        @default(now()) @map("dateCreation")
  opponent           String?         @map("adversaire")
  locationData       Json?
  weatherData        Json?
  clubId             String
  /// null = club-wide event (visible in every section, no call-ups / attendance / stats).
  teamId             String?         @map("equipeId")
  /// Shared by the occurrences of a weekly repeated training (null for a single event).
  seriesId           String?
  /// Set when the reminder (notification + email, 24h before) has been sent: never sent twice.
  reminderSentAt     DateTime?
  /// Home or away match (carpool is offered for away matches only). Trainings stay "home".
  isHome             Boolean         @default(true)
  /// Man of the match: set when the vote-open notification has been sent (claimed by the job).
  motmOpenNotifiedAt DateTime?
  /// Man of the match: set when the vote has been closed and the winner(s) notified (claimed by the job).
  motmClosedAt       DateTime?
  callUps            CallUp[]
  motmVotes          MotmVote[]
  rides              Ride[]
  ridePassengers     RidePassenger[]
  club               Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team               Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attendances        Attendance[]
  teamStat           TeamStat?
  playerStats        PlayerStat[]

  @@index([teamId])
  @@index([clubId, startDate])
  @@index([seriesId])
  @@map("evenement")
}

model Poll {
  id        String         @id @default(cuid())
  question  String
  options   String[]
  isMulti   Boolean        @default(false)
  expiresAt DateTime?
  createdAt DateTime       @default(now())
  creatorId String         @map("createurId")
  teamId    String         @map("equipeId")
  responses PollResponse[]
  creator   User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("sondage")
}

model PollResponse {
  id        String   @id @default(cuid())
  choice    String   @map("choix")
  createdAt DateTime @default(now())
  userId    String   @map("utilisateurId")
  pollId    String   @map("sondageId")
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One vote per option and per user (a single-choice poll also keeps one row per user, see vote()).
  @@unique([pollId, userId, choice])
  @@index([pollId])
  @@map("reponse_sondage")
}

/// Belongs to a club (`clubId`); legacy rows of users who owned no club keep `userId` instead.
model Subscription {
  id        String             @id @default(cuid())
  clubId    String?            @unique
  userId    String?            @unique
  plan      Plan
  period    SubscriptionPeriod @map("periode")
  startDate DateTime           @default(now()) @map("datedebut")
  endDate   DateTime           @updatedAt @map("datefin")
  club      Club?              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("abonnement")
}

/// Stripe webhook events already handled: Stripe retries deliveries, each event is processed once.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_event")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Attendance {
  id        String           @id @default(cuid())
  status    AttendanceStatus @default(PENDING) @map("statut")
  createdAt DateTime         @default(now()) @map("dateCreation")
  userId    String
  eventId   String           @map("evenementId")
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("presence")
}

model PlayerStat {
  id            String          @id @default(cuid())
  goals         Int             @default(0) @map("buts")
  assists       Int             @default(0) @map("passesdecisive")
  /// null = not rated yet (a row created from the playing-time sheet).
  rating        Float?          @map("note")
  /// 0..130 (extra time included), see features/stats/playing-time.ts.
  minutesPlayed Int             @default(0) @map("minutesJouees")
  isStarter     Boolean         @default(false) @map("titulaire")
  /// null = not set (playing-time sheet for a member without a usual position).
  position      PlayerPosition? @map("poste")
  createdAt     DateTime        @default(now()) @map("dateCreation")
  userId        String
  eventId       String          @map("evenementId")
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("statistique_joueur")
}

/// One man-of-the-match vote per voter and per match (the vote can be changed while it is open).
/// Window, eligibility and winners: features/motm/rules.ts.
model MotmVote {
  id        String   @id @default(cuid())
  eventId   String
  voterId   String
  nomineeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voter     User     @relation("MotmVoter", fields: [voterId], references: [id], onDelete: Cascade)
  nominee   User     @relation("MotmNominee", fields: [nomineeId], references: [id], onDelete: Cascade)

  @@unique([eventId, voterId])
  @@index([eventId, nomineeId])
  @@index([nomineeId])
  @@map("motm_vote")
}

/// A car going to an away match: one per driver and per match (features/carpool/rules.ts).
model Ride {
  id             String          @id @default(cuid())
  eventId        String
  driverId       String
  seats          Int
  departurePlace String
  departureTime  DateTime
  note           String?
  createdAt      DateTime        @default(now())
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  driver         User            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  passengers     RidePassenger[]

  @@unique([eventId, driverId])
  @@map("ride")
}

/// A booked seat. `eventId` is denormalized so that a user holds at most one seat per match.
model RidePassenger {
  id        String   @id @default(cuid())
  rideId    String
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([rideId])
  @@map("ride_passenger")
}

model TeamStat {
  id            String      @id @default(cuid())
  result        MatchResult @map("resultatMatch")
  goalsFor      Int         @default(0) @map("butsMarques")
  goalsAgainst  Int         @default(0) @map("butsEncaisses")
  cleanSheet    Boolean     @default(false)
  totalShots    Int?        @map("tirsTotal")
  shotsOnTarget Int?        @map("tirsCadres")
  isHome        Boolean     @default(true) @map("domicile")
  competition   Competition @default(LEAGUE)
  opponent      String      @map("adversaire")
  createdAt     DateTime    @default(now()) @map("dateCreation")
  teamId        String      @map("equipeId")
  eventId       String?     @unique @map("evenementId")
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event         Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("statistique_equipe")
}

model Notification {
  id            String           @id @default(cuid())
  type          NotificationType
  title         String
  message       String
  data          Json?
  read          Boolean          @default(false)
  delivered     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  userId        String
  fromUserImage String?
  fromUserName  String?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, delivered])
  @@index([createdAt])
  @@map("notification")
}

model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType          @default(PRIVATE)
  name         String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  creatorId    String?
  creator      User?                     @relation("GroupCreator", fields: [creatorId], references: [id])
  // Set only for TEAM conversations: one channel per section, members are synced automatically.
  teamId       String?                   @unique
  team         Team?                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Set only for CLUB conversations: one channel per club (every club member).
  clubId       String?                   @unique
  club         Club?                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  user         User?                     @relation(fields: [userId], references: [id])
  userId       String?

  @@map("conversation")
}

model ConversationParticipant {
  id               String          @id @default(cuid())
  joinedAt         DateTime        @default(now())
  isPinned         Boolean         @default(false)
  lastReadAt       DateTime?
  pinnedMessageIds String[]        @default([])
  role             ParticipantRole @default(MEMBER)
  userId           String
  conversationId   String
  conversation     Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@map("conversation_participant")
}

model Message {
  id             String            @id @default(cuid())
  content        String
  createdAt      DateTime          @default(now())
  read           Boolean           @default(false)
  readAt         DateTime?
  deletedForAll  Boolean           @default(false)
  senderId       String
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  deletions      MessageDeletion[]

  @@index([conversationId, createdAt])
  @@map("message")
}

model MessageDeletion {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_deletion")
}

enum CallUpStatus {
  PENDING   @map("EN_ATTENTE")
  CONFIRMED @map("CONFIRME")
  DECLINED  @map("REFUSE")
  EXPIRED   @map("EXPIRE")

  @@map("StatutConvocation")
}

enum ConversationType {
  PRIVATE
  GROUP
  TEAM
  CLUB
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

enum NotificationType {
  CALL_UP          @map("CONVOCATION_MATCH")
  JOIN_REQUEST     @map("DEMANDE_ADHESION")
  INJURY_REPORTED  @map("BLESSURE_DECLAREE")
  FINANCE_DUE      @map("FINANCE_ECHEANCE")
  NEW_POLL         @map("SONDAGE_NOUVEAU")
  EVENT_REMINDER   @map("EVENEMENT_RAPPEL")
  JOINED_TEAM      @map("REJOINT_CLUB")
  LEFT_TEAM        @map("QUITTER_CLUB")
  MESSAGE
  MAN_OF_THE_MATCH
  CARPOOL

  @@map("TypeNotification")
}

enum UserRole {
  ADMIN @map("Admin")
  USER  @map("utilisateur")

  @@map("Roles")
}

enum Plan {
  free
  pro
}

enum SubscriptionPeriod {
  MONTH @map("mois")
  YEAR  @map("annee")

  @@map("PlanAbonnement")
}

enum TeamRole {
  NO_CLUB @map("SANSCLUB")
  COACH   @map("ENTRAINEUR")
  PLAYER  @map("JOUEUR")

  @@map("RoleEquipe")
}

enum PlayerPosition {
  GOALKEEPER              @map("GARDIEN")
  RIGHT_BACK              @map("DEFENSEUR_LATERAL_DROIT")
  CENTER_BACK             @map("DEFENSEUR_CENTRAL")
  LEFT_BACK               @map("DEFENSEUR_LATERAL_GAUCHE")
  DEFENSIVE_MIDFIELDER    @map("MILIEU_DEFENSIF")
  CENTRAL_MIDFIELDER      @map("MILIEU_CENTRAL")
  ATTACKING_MIDFIELDER    @map("MILIEU_OFFENSIF")
  BALL_WINNING_MIDFIELDER @map("MILIEU_RECUPERATEUR")
  BOX_TO_BOX_MIDFIELDER   @map("MILIEU_RELAYEUR")
  STRIKER                 @map("ATTAQUANT_DE_POINTE")
  SUPPORT_STRIKER         @map("ATTAQUANT_DE_SOUTIEN")
  LEFT_WINGER             @map("AILIER_GAUCHE")
  RIGHT_WINGER            @map("AILIER_DROIT")
  SECOND_STRIKER          @map("SECOND_ATTAQUANT")

  @@map("PosteJoueur")
}

enum EventType {
  TRAINING @map("ENTRAINEMENT")
  LEAGUE   @map("CHAMPIONNAT")
  CUP      @map("COUPE")

  @@map("TypeEvenement")
}

enum AttendanceStatus {
  PENDING @map("ATTENTE")
  PRESENT
  ABSENT

  @@map("StatutPresence")
}

enum MatchResult {
  WIN  @map("VICTOIRE")
  LOSS @map("DEFAITE")
  DRAW @map("NUL")

  @@map("ResultatMatch")
}

enum Competition {
  LEAGUE @map("CHAMPIONNAT")
  CUP    @map("COUPE")

  @@map("competition")
}

enum ClubRole {
  OWNER
  ADMIN
  MEMBER
}

enum SectionCategory {
  SENIOR
  VETERAN
  LEISURE
}

enum ClubVisibility {
  PUBLIC
  PRIVATE    @map("PRIVE")
  INVITATION

  @@map("StatutClub")
}

// French league names are kept as-is (proper nouns), only LOISIR is translated.
enum TeamLevel {
  DEPARTEMENTAL_1
  DEPARTEMENTAL_2
  DEPARTEMENTAL_3
  REGIONAL_1
  REGIONAL_2
  REGIONAL_3
  NATIONAL_1
  NATIONAL_2
  NATIONAL_3
  RECREATIONAL    @map("LOISIR")

  @@map("NiveauClub")
}

enum JoinRequestStatus {
  PENDING  @map("ATTENTE")
  ACCEPTED @map("ACCEPTEE")
  REJECTED @map("REFUSEE")

  @@map("StatutDemande")
}

enum FinanceType {
  FEE     @map("COTISATION")
  EXPENSE @map("DEPENSE")

  @@map("TypeFinance")
}
