generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Models and fields are named in English. `@map` / `@@map` keep the original
// (French) database table, column and enum names, so no data migration is needed.

model User {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  email                    String                    @unique
  emailVerified            Boolean
  image                    String?
  role                     UserRole                  @default(USER)
  plan                     Plan                      @default(free)
  clientId                 String?                   @unique
  resetToken               String?
  resetTokenExpiry         DateTime?
  createdAt                DateTime
  updatedAt                DateTime
  isOnline                 Boolean                   @default(false)
  lastSeen                 DateTime?
  callUps                  CallUp[]
  memberships              TeamMember[]
  subscription             Subscription?
  accounts                 Account[]
  injuries                 Injury[]
  conversationParticipants ConversationParticipant[]
  joinRequests             JoinRequest[]
  finances                 Finance[]
  sentMessages             Message[]
  notifications            Notification[]
  attendances              Attendance[]
  pollResponses            PollResponse[]
  sessions                 Session[]
  createdPolls             Poll[]
  playerStats              PlayerStat[]
  favoriteTeams            Team[]                    @relation("ClubsFavoris")
  favoritePlayers          User[]                    @relation("JoueursFavoris")
  favoritedBy              User[]                    @relation("JoueursFavoris")
  messageDeletions         MessageDeletion[]
  blockedUsers             User[]                    @relation("UserBlocks")
  blockedBy                User[]                    @relation("UserBlocks")
  createdGroups            Conversation[]            @relation("GroupCreator")
  conversations            Conversation[]

  @@map("user")
}

model Team {
  id           String         @id @default(cuid())
  name         String         @map("nom")
  description  String?
  logoUrl      String?
  createdAt    DateTime       @default(now()) @map("dateCreation")
  inviteCode   String?        @map("codeInvitation")
  visibility   TeamVisibility @default(PUBLIC) @map("statut")
  level        TeamLevel      @default(RECREATIONAL) @map("niveau")
  members      TeamMember[]
  injuries     Injury[]
  joinRequests JoinRequest[]
  events       Event[]
  finances     Finance[]
  polls        Poll[]
  teamStats    TeamStat[]
  favoritedBy  User[]         @relation("ClubsFavoris")
  conversation Conversation?

  @@map("equipe")
}

model TeamMember {
  id         String          @id @default(cuid())
  role       TeamRole        @default(PLAYER)
  position   PlayerPosition? @map("poste")
  isLicensed Boolean         @default(false)
  joinedAt   DateTime        @default(now())
  userId     String
  teamId     String          @map("equipeId")
  team       Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("MembreEquipe")
}

model JoinRequest {
  id         String            @id @default(cuid())
  position   PlayerPosition    @map("poste")
  motivation String
  status     JoinRequestStatus @default(PENDING) @map("statut")
  createdAt  DateTime          @default(now())
  userId     String
  teamId     String            @map("equipeId")
  level      TeamLevel         @map("niveau")
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("demande_adhesion")
}

model Injury {
  id          String   @id @default(cuid())
  type        String
  description String?
  startDate   DateTime
  endDate     DateTime
  isRecurring Boolean  @default(false)
  userId      String
  teamId      String   @map("equipeId")
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@map("blessure")
}

model Finance {
  id          String      @id @default(cuid())
  amount      Float       @map("montant")
  type        FinanceType
  description String
  isPaid      Boolean     @default(false)
  dueDate     DateTime?   @map("dateEcheance")
  userId      String
  teamId      String      @map("equipeId")
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("finance")
}

model CallUp {
  id          String       @id @default(cuid())
  userId      String
  eventId     String       @map("evenementId")
  status      CallUpStatus @default(PENDING) @map("statut")
  sentAt      DateTime     @default(now()) @map("dateEnvoi")
  respondedAt DateTime?    @map("dateReponse")
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, status])
  @@map("Convocation")
}

model Event {
  id             String       @id @default(cuid())
  title          String       @map("titre")
  description    String?
  location       String?      @map("lieu")
  type           EventType    @default(TRAINING) @map("typeEvenement")
  startDate      DateTime     @map("dateDebut")
  createdAt      DateTime     @default(now()) @map("dateCreation")
  opponent       String?      @map("adversaire")
  locationData   Json?
  weatherData    Json?
  teamId         String       @map("equipeId")
  /// Shared by the occurrences of a weekly repeated training (null for a single event).
  seriesId       String?
  /// Set when the reminder (notification + email, 24h before) has been sent: never sent twice.
  reminderSentAt DateTime?
  callUps        CallUp[]
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attendances    Attendance[]
  teamStat       TeamStat?
  playerStats    PlayerStat[]

  @@index([teamId])
  @@index([seriesId])
  @@map("evenement")
}

model Poll {
  id        String         @id @default(cuid())
  question  String
  options   String[]
  isMulti   Boolean        @default(false)
  expiresAt DateTime?
  createdAt DateTime       @default(now())
  creatorId String         @map("createurId")
  teamId    String         @map("equipeId")
  responses PollResponse[]
  creator   User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("sondage")
}

model PollResponse {
  id        String   @id @default(cuid())
  choice    String   @map("choix")
  createdAt DateTime @default(now())
  userId    String   @map("utilisateurId")
  pollId    String   @map("sondageId")
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One vote per option and per user (a single-choice poll also keeps one row per user, see vote()).
  @@unique([pollId, userId, choice])
  @@index([pollId])
  @@map("reponse_sondage")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  plan      Plan
  period    SubscriptionPeriod @map("periode")
  startDate DateTime           @default(now()) @map("datedebut")
  endDate   DateTime           @updatedAt @map("datefin")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("abonnement")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Attendance {
  id        String           @id @default(cuid())
  status    AttendanceStatus @default(PENDING) @map("statut")
  createdAt DateTime         @default(now()) @map("dateCreation")
  userId    String
  eventId   String           @map("evenementId")
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("presence")
}

model PlayerStat {
  id            String         @id @default(cuid())
  goals         Int            @default(0) @map("buts")
  assists       Int            @default(0) @map("passesdecisive")
  rating        Float          @default(6.0) @map("note")
  minutesPlayed Int            @default(0) @map("minutesJouees")
  isStarter     Boolean        @default(false) @map("titulaire")
  position      PlayerPosition @map("poste")
  createdAt     DateTime       @default(now()) @map("dateCreation")
  userId        String
  eventId       String         @map("evenementId")
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("statistique_joueur")
}

model TeamStat {
  id            String      @id @default(cuid())
  result        MatchResult @map("resultatMatch")
  goalsFor      Int         @default(0) @map("butsMarques")
  goalsAgainst  Int         @default(0) @map("butsEncaisses")
  cleanSheet    Boolean     @default(false)
  totalShots    Int?        @map("tirsTotal")
  shotsOnTarget Int?        @map("tirsCadres")
  isHome        Boolean     @default(true) @map("domicile")
  competition   Competition @default(LEAGUE)
  opponent      String      @map("adversaire")
  createdAt     DateTime    @default(now()) @map("dateCreation")
  teamId        String      @map("equipeId")
  eventId       String?     @unique @map("evenementId")
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event         Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("statistique_equipe")
}

model Notification {
  id            String           @id @default(cuid())
  type          NotificationType
  title         String
  message       String
  data          Json?
  read          Boolean          @default(false)
  delivered     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  userId        String
  fromUserImage String?
  fromUserName  String?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, delivered])
  @@index([createdAt])
  @@map("notification")
}

model Conversation {
  id           String                    @id @default(cuid())
  type         ConversationType          @default(PRIVATE)
  name         String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  creatorId    String?
  creator      User?                     @relation("GroupCreator", fields: [creatorId], references: [id])
  // Set only for TEAM conversations: one channel per team, members are synced automatically.
  teamId       String?                   @unique
  team         Team?                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  user         User?                     @relation(fields: [userId], references: [id])
  userId       String?

  @@map("conversation")
}

model ConversationParticipant {
  id               String          @id @default(cuid())
  joinedAt         DateTime        @default(now())
  isPinned         Boolean         @default(false)
  lastReadAt       DateTime?
  pinnedMessageIds String[]        @default([])
  role             ParticipantRole @default(MEMBER)
  userId           String
  conversationId   String
  conversation     Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@map("conversation_participant")
}

model Message {
  id             String            @id @default(cuid())
  content        String
  createdAt      DateTime          @default(now())
  read           Boolean           @default(false)
  readAt         DateTime?
  deletedForAll  Boolean           @default(false)
  senderId       String
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  deletions      MessageDeletion[]

  @@index([conversationId, createdAt])
  @@map("message")
}

model MessageDeletion {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_deletion")
}

enum CallUpStatus {
  PENDING   @map("EN_ATTENTE")
  CONFIRMED @map("CONFIRME")
  DECLINED  @map("REFUSE")
  EXPIRED   @map("EXPIRE")

  @@map("StatutConvocation")
}

enum ConversationType {
  PRIVATE
  GROUP
  TEAM
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

enum NotificationType {
  CALL_UP         @map("CONVOCATION_MATCH")
  JOIN_REQUEST    @map("DEMANDE_ADHESION")
  INJURY_REPORTED @map("BLESSURE_DECLAREE")
  FINANCE_DUE     @map("FINANCE_ECHEANCE")
  NEW_POLL        @map("SONDAGE_NOUVEAU")
  EVENT_REMINDER  @map("EVENEMENT_RAPPEL")
  JOINED_TEAM     @map("REJOINT_CLUB")
  LEFT_TEAM       @map("QUITTER_CLUB")
  MESSAGE

  @@map("TypeNotification")
}

enum UserRole {
  ADMIN @map("Admin")
  USER  @map("utilisateur")

  @@map("Roles")
}

enum Plan {
  free
  pro
}

enum SubscriptionPeriod {
  MONTH @map("mois")
  YEAR  @map("annee")

  @@map("PlanAbonnement")
}

enum TeamRole {
  NO_CLUB @map("SANSCLUB")
  COACH   @map("ENTRAINEUR")
  PLAYER  @map("JOUEUR")

  @@map("RoleEquipe")
}

enum PlayerPosition {
  GOALKEEPER              @map("GARDIEN")
  RIGHT_BACK              @map("DEFENSEUR_LATERAL_DROIT")
  CENTER_BACK             @map("DEFENSEUR_CENTRAL")
  LEFT_BACK               @map("DEFENSEUR_LATERAL_GAUCHE")
  DEFENSIVE_MIDFIELDER    @map("MILIEU_DEFENSIF")
  CENTRAL_MIDFIELDER      @map("MILIEU_CENTRAL")
  ATTACKING_MIDFIELDER    @map("MILIEU_OFFENSIF")
  BALL_WINNING_MIDFIELDER @map("MILIEU_RECUPERATEUR")
  BOX_TO_BOX_MIDFIELDER   @map("MILIEU_RELAYEUR")
  STRIKER                 @map("ATTAQUANT_DE_POINTE")
  SUPPORT_STRIKER         @map("ATTAQUANT_DE_SOUTIEN")
  LEFT_WINGER             @map("AILIER_GAUCHE")
  RIGHT_WINGER            @map("AILIER_DROIT")
  SECOND_STRIKER          @map("SECOND_ATTAQUANT")

  @@map("PosteJoueur")
}

enum EventType {
  TRAINING @map("ENTRAINEMENT")
  LEAGUE   @map("CHAMPIONNAT")
  CUP      @map("COUPE")

  @@map("TypeEvenement")
}

enum AttendanceStatus {
  PENDING @map("ATTENTE")
  PRESENT
  ABSENT

  @@map("StatutPresence")
}

enum MatchResult {
  WIN  @map("VICTOIRE")
  LOSS @map("DEFAITE")
  DRAW @map("NUL")

  @@map("ResultatMatch")
}

enum Competition {
  LEAGUE @map("CHAMPIONNAT")
  CUP    @map("COUPE")

  @@map("competition")
}

enum TeamVisibility {
  PUBLIC
  PRIVATE    @map("PRIVE")
  INVITATION

  @@map("StatutClub")
}

// French league names are kept as-is (proper nouns), only LOISIR is translated.
enum TeamLevel {
  DEPARTEMENTAL_1
  DEPARTEMENTAL_2
  DEPARTEMENTAL_3
  REGIONAL_1
  REGIONAL_2
  REGIONAL_3
  NATIONAL_1
  NATIONAL_2
  NATIONAL_3
  RECREATIONAL    @map("LOISIR")

  @@map("NiveauClub")
}

enum JoinRequestStatus {
  PENDING  @map("ATTENTE")
  ACCEPTED @map("ACCEPTEE")
  REJECTED @map("REFUSEE")

  @@map("StatutDemande")
}

enum FinanceType {
  FEE     @map("COTISATION")
  EXPENSE @map("DEPENSE")

  @@map("TypeFinance")
}
