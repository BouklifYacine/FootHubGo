# Exemple de fichier .env pour FootHubGo

# Base de données PostgreSQL
DATABASE_URL="" # URL de connexion de l'application
DIRECT_URL="" # URL directe pour Prisma (si différente de DATABASE_URL)

# Better Auth
BETTER_AUTH_SECRET="" # Générer avec : openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# Connexion OAuth (facultative)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Emails via Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FootHubGo <adresse@votre-domaine.fr>"

# URL utilisée comme origine autorisée par Socket.IO
NEXT_PUBLIC_URL="http://localhost:3000"

# AWS S3 ou stockage compatible
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="auto"
AWS_ENDPOINT_URL_S3="" # Facultatif pour AWS S3 standard
S3_BUCKET_NAME=""

# Stripe (facultatif)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MONTHLY_PRICE_ID=""
STRIPE_YEARLY_PRICE_ID=""
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=""

# Notifications push (Web Push, VAPID). Facultatif : sans ces trois variables, les notifications push
# sont désactivées (le reste de l'application fonctionne). Générer une paire de clés UNE fois :
#   bunx web-push generate-vapid-keys
# Ne jamais changer de clés en production : les appareils déjà abonnés ne recevraient plus rien
# (ils se réabonnent à la prochaine ouverture de l'application).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@votre-domaine.fr" # adresse de contact (mailto:) ou URL https du site

# Serveur
PORT="3000"
# IP du client (limites de tentatives, sessions). Vide par défaut : adresse TCP de la connexion,
# correct si l'application est exposée directement. Derrière un reverse proxy, mettre l'en-tête
# que CE proxy écrit (ex. "x-real-ip", "fly-client-ip", "cf-connecting-ip" ; "x-forwarded-for" =
# dernière valeur de la liste), et ne rendre le port de l'application accessible QUE par le proxy :
# sinon un client peut envoyer cet en-tête lui-même et contourner les limites.
TRUSTED_IP_HEADER=""

# PostgreSQL local avec Docker (facultatif)
POSTGRES_PASSWORD="postgres"
POSTGRES_USER="postgres"
POSTGRES_DB="foothubgo"
# Tâches de fond (rappels d’événements). Mettre 1 pour les désactiver sur cette instance.
DISABLE_JOBS=
